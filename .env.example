# Optional. Keystone needs no .env: use the setup screen and Settings page instead.
# Anything set here overrides the matching setting and is shown locked in the UI.
# KEYSTONE_ISSUER_URL=https://auth.example.com
# KEYSTONE_COOKIE_DOMAIN=.example.com
# KEYSTONE_TRUST_PROXY=loopback,linklocal,uniquelocal
# If you change the host port, set the public URL in Settings (/admin/settings) (default http://localhost:9000).
# KEYSTONE_HOST_PORT=9000

# Direct access by IP on your network (no reverse proxy): bind to all interfaces and set the
# issuer to the address people open. Plain HTTP: use only on a trusted LAN, not the internet.
# KEYSTONE_BIND_ADDRESS=0.0.0.0
# KEYSTONE_ISSUER_URL=http://192.168.1.10:9000

# For an existing Postgres volume, retain its original password here.
# POSTGRES_PASSWORD=your-existing-database-password

# Log verbosity: fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info

# First admin, created only while the database has no users. Never resets an existing password.
# Username: 2-64 letters, digits or . _ @ -; password: at least 12 characters.
# KEYSTONE_BOOTSTRAP_ADMIN_USER=admin
# KEYSTONE_BOOTSTRAP_ADMIN_PASSWORD=
# KEYSTONE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Master encryption key (openssl rand -base64 32). By default Keystone generates one on first
# start and keeps it in the authi-data volume. WARNING: setting or changing this after first
# start makes existing encrypted data (signing keys, client secrets) unreadable.
# KEYSTONE_SECRET_KEY=
