# Optional local deployment overrides. A fresh local setup needs no .env file.
# KEYSTONE_ISSUER_URL=https://auth.example.com
# KEYSTONE_COOKIE_DOMAIN=.example.com
# KEYSTONE_TRUST_PROXY=loopback,linklocal,uniquelocal
# KEYSTONE_HOST_PORT=9000

# For an existing Postgres volume, retain its original password here.
# POSTGRES_PASSWORD=your-existing-database-password