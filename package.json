{
  "name": "keystone",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "mock": "node scripts/serve-mock.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/civr/Auth.i.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/civr/Auth.i/issues"
  },
  "homepage": "https://github.com/civr/Auth.i#readme",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/middie": "^9.3.5",
    "argon2": "^0.45.1",
    "eta": "^4.6.0",
    "fastify": "^5.12.7",
    "kysely": "^0.29.6",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "light-my-request": "^6.8.0",
    "openid-client": "^6.8.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.4"
  }
}
